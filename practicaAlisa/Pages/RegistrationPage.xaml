<Page x:Class="practicaAlisa.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900"
      Title="Регистрация - Комфорт"
      Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#D2DFFF" CornerRadius="10" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <TextBlock Text="Регистрация нового сотрудника" 
                               FontSize="28" FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Foreground="#355CBD"/>
                    <TextBlock Text="Заполните все поля для создания учетной записи" 
                               FontSize="12" 
                               HorizontalAlignment="Center" 
                               Foreground="Gray"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#D2DFFF" CornerRadius="10" Padding="30" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Данные для входа" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="#355CBD" Margin="0,0,0,10"
                               Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="login" Grid.Row="1" Grid.Column="1" 
                             Height="35" Width="300" HorizontalAlignment="Left"
                             Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <PasswordBox x:Name="password" Grid.Row="2" Grid.Column="1" 
                                 Height="35" Width="300" HorizontalAlignment="Left"
                                 Margin="0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Подтверждение пароля:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <PasswordBox x:Name="confirmPassword" Grid.Row="3" Grid.Column="1" 
                                 Height="35" Width="300" HorizontalAlignment="Left"
                                 Margin="0,5"/>

                    <Rectangle Grid.Row="4" Height="1" Fill="#CCCCCC" Margin="0,15" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Личные данные" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="#355CBD" Margin="0,10,0,10"
                               Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Фамилия:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="surname" Grid.Row="6" Grid.Column="1" 
                             Height="35" Width="300" HorizontalAlignment="Left"
                             Margin="0,5"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Имя:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="name" Grid.Row="7" Grid.Column="1" 
                             Height="35" Width="300" HorizontalAlignment="Left"
                             Margin="0,5"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Отчество:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="patronymic" Grid.Row="8" Grid.Column="1" 
                             Height="35" Width="300" HorizontalAlignment="Left"
                             Margin="0,5"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Дата рождения:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <DatePicker x:Name="birthday" Grid.Row="9" Grid.Column="1" 
                                Height="35" Width="300" HorizontalAlignment="Left"
                                Margin="0,5"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Серия паспорта:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="passportSeries" Grid.Row="10" Grid.Column="1" 
                             Height="35" Width="300" HorizontalAlignment="Left"
                             Margin="0,5" MaxLength="4"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Номер паспорта:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox x:Name="passportNumber" Grid.Row="11" Grid.Column="1" 
                             Height="35" Width="300" HorizontalAlignment="Left"
                             Margin="0,5" MaxLength="6"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#D2DFFF" CornerRadius="10" Padding="30" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Семейное положение:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox x:Name="familyStatusCombo" Grid.Row="0" Grid.Column="1" 
                              DisplayMemberPath="NmaeStatus" 
                              SelectedValuePath="Id_status"
                              Height="35" Width="300" HorizontalAlignment="Left"
                              Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Состояние здоровья:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox x:Name="healthCombo" Grid.Row="1" Grid.Column="1" 
                              DisplayMemberPath="NameHealth" 
                              SelectedValuePath="Id_health"
                              Height="35" Width="300" HorizontalAlignment="Left"
                              Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Должность:" 
                               FontSize="14" VerticalAlignment="Center" Margin="0,5"/>
                    <ComboBox x:Name="positionCombo" Grid.Row="2" Grid.Column="1" 
                              DisplayMemberPath="NameRole" 
                              SelectedValuePath="Id_role"
                              Height="35" Width="300" HorizontalAlignment="Left"
                              Margin="0,5"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button x:Name="registrationBtn" 
                        Content="Зарегистрироваться" 
                        Width="200" Height="45" FontSize="14"
                        Background="#355CBD" Foreground="White"
                        Click="registration_Click"/>

                <Button x:Name="backBtn" 
                        Content="Назад" 
                        Width="120" Height="45" FontSize="14"
                        Background="Gray" Foreground="White"
                        Click="back_Click"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>