<Page x:Class="practicaAlisa.Pages.PartnersAddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:practicaAlisa.Pages"
      mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="600"
      Title="Редактирование партнера - Комфорт"
      Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Информация о партнере" FontSize="24" FontWeight="Bold" 
                       Foreground="#355CBD" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Background="#D2DFFF" Padding="20" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NamePartner, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Width="230"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип партнера:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <ComboBox x:Name="TypeCB" Grid.Row="1" Grid.Column="1" Height="35" Width="230" 
                              DisplayMemberPath="NameBusiness" SelectedValuePath="Id_type"
                              Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Юр. адрес:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UrAdress, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Width="230" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ИНН:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding INN, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Width="230" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ФИО директора:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                        <TextBox Text="{Binding SurnameDirector, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="35" Width="230" Margin="0,0,0,5" Tag="Фамилия"/>
                        <TextBox Text="{Binding NameDirector, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="35" Width="230" Margin="0,0,0,5" Tag="Имя"/>
                        <TextBox Text="{Binding PatronumicDirector, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="35" Width="230" Tag="Отчество"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Телефон:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Width="230" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Width="230" Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Рейтинг (0-5):" FontSize="14" 
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Raiting, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Width="230" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="SaveBtn" Content="Сохранить" Width="120" Height="40" FontSize="14"
                        Background="#355CBD" Foreground="White" Click="SaveBtn_Click"/>
                <Button x:Name="CanselBtn" Content="Отмена" Width="120" Height="40" FontSize="14"
                        Background="Gray" Foreground="White" Click="CanselBtn_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>